<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.BreastScan" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Background + Surface -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/pinkLight</item>
        <item name="colorOnSurface">@color/white</item>

        <!-- Brand Colors -->
        <item name="colorPrimary">@color/pinkPrimary</item>
        <item name="colorPrimaryVariant">@color/pinkDark</item>
        <item name="colorSecondary">@color/pinkLight</item>

        <!-- Text -->
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>

    </style>

</resources>
