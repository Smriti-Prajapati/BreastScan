<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Screen title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick Self Check"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/pinkPrimary"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp" />

        <!-- Question Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/colorCardBackground"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tvQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Question"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary"
                    android:gravity="center"
                    android:layout_marginBottom="24dp" />

                <!-- Age Input -->
                <EditText
                    android:id="@+id/etAge"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:hint="Enter your age"
                    android:inputType="number"
                    android:visibility="gone"
                    android:background="@drawable/edittext_bg"
                    android:padding="14dp"
                    android:textColor="@color/colorTextPrimary"
                    android:textColorHint="@color/colorTextHint"
                    android:layout_marginBottom="20dp" />

                <!-- YES / NO -->
                <LinearLayout
                    android:id="@+id/btnLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnYes"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="YES"
                        android:textAllCaps="false"
                        android:textColor="@color/colorTextOnPrimary"
                        app:cornerRadius="14dp"
                        app:backgroundTint="@color/pinkPrimary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNo"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="NO"
                        android:textAllCaps="false"
                        android:textColor="@color/pinkPrimary"
                        app:cornerRadius="14dp"
                        app:backgroundTint="@color/colorSurfaceVariant"
                        app:strokeColor="@color/pinkPrimary"
                        app:strokeWidth="1.5dp" />
                </LinearLayout>

                <!-- Next Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNext"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Next"
                    android:textAllCaps="false"
                    android:textColor="@color/colorTextOnPrimary"
                    android:visibility="gone"
                    android:layout_marginTop="16dp"
                    app:cornerRadius="14dp"
                    app:backgroundTint="@color/pinkPrimary" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Result — TextView id kept as tvResult for Java compatibility -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/colorCardBackground"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:padding="24dp"
                android:textSize="15sp"
                android:textColor="@color/colorTextPrimary"
                android:lineSpacingExtra="5dp" />
        </androidx.cardview.widget.CardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHospital"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Find Nearby Hospitals"
            android:textAllCaps="false"
            android:textColor="@color/colorTextOnPrimary"
            android:layout_marginBottom="24dp"
            android:visibility="gone"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/pinkPrimary" />

    </LinearLayout>
</ScrollView>
