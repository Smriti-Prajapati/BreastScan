<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ══════════════════════════════════════════════════════════
         MAIN CONTENT
    ══════════════════════════════════════════════════════════ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/colorBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/colorHeaderBackground"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:elevation="4dp">

                <ImageView
                    android:id="@+id/btnMenu"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_menu"
                    app:tint="#FFFFFF"
                    android:contentDescription="Menu" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="BreastScan"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp" />

            </LinearLayout>

            <!-- WELCOME SECTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/tvWelcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome 👋"
                    android:textColor="@color/pinkPrimary"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Choose how you want to check your health"
                    android:textSize="14sp"
                    android:textColor="@color/colorTextSecondary"
                    android:layout_marginBottom="24dp" />

                <!-- FEATURE CARDS -->

                <!-- Quick Self Check -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btnQuickCheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/colorCardBackground"
                    android:layout_marginBottom="14dp"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp">

                        <LinearLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/icon_bg_pink"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_check"
                                app:tint="@color/pinkPrimary"
                                android:contentDescription="Quick Check" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Quick Self Check"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorTextPrimary" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Answer a few questions"
                                android:textSize="12sp"
                                android:textColor="@color/colorTextSecondary" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/colorTextSecondary"
                            android:contentDescription="Go" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Form Prediction -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btnForm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/colorCardBackground"
                    android:layout_marginBottom="14dp"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp">

                        <LinearLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/icon_bg_pink"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_form"
                                app:tint="@color/pinkPrimary"
                                android:contentDescription="Form" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Form Prediction"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorTextPrimary" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Enter clinical measurements"
                                android:textSize="12sp"
                                android:textColor="@color/colorTextSecondary" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/colorTextSecondary"
                            android:contentDescription="Go" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Image Prediction -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btnImage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/colorCardBackground"
                    android:layout_marginBottom="14dp"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp">

                        <LinearLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/icon_bg_pink"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_image"
                                app:tint="@color/pinkPrimary"
                                android:contentDescription="Image" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Image Prediction"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorTextPrimary" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Analyse a scan image with AI"
                                android:textSize="12sp"
                                android:textColor="@color/colorTextSecondary" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/colorTextSecondary"
                            android:contentDescription="Go" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Medical Document Q&A -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btnMedicalQA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/colorCardBackground"
                    android:layout_marginBottom="24dp"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp">

                        <LinearLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/icon_bg_pink"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_document"
                                app:tint="@color/pinkPrimary"
                                android:contentDescription="Document" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Medical Document Q&amp;A"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorTextPrimary" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ask questions about your PDF"
                                android:textSize="12sp"
                                android:textColor="@color/colorTextSecondary" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/colorTextSecondary"
                            android:contentDescription="Go" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ══════════════════════════════════════════════════════════
         LEFT DRAWER
    ══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/drawerMenu"
        android:layout_width="290dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@color/colorDrawerBackground"
        android:paddingTop="48dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp">

        <!-- Drawer header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BreastScan"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/pinkPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Early detection saves lives"
                android:textSize="12sp"
                android:textColor="@color/colorTextSecondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/colorDivider"
            android:layout_marginBottom="8dp" />

        <!-- PROFILE -->
        <LinearLayout
            android:id="@+id/menuProfile"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center_vertical"
            android:foreground="?attr/selectableItemBackground">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_person" app:tint="@color/colorTextSecondary" android:contentDescription="Profile"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Profile" android:layout_marginStart="16dp" android:textSize="15sp" android:textColor="@color/colorTextPrimary"/>
        </LinearLayout>

        <!-- INFO -->
        <LinearLayout
            android:id="@+id/menuInfo"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center_vertical"
            android:foreground="?attr/selectableItemBackground">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_info" app:tint="@color/colorTextSecondary" android:contentDescription="Info"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Breast Cancer Info" android:layout_marginStart="16dp" android:textSize="15sp" android:textColor="@color/colorTextPrimary"/>
        </LinearLayout>

        <!-- PRIVACY -->
        <LinearLayout
            android:id="@+id/menuPrivacy"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center_vertical"
            android:foreground="?attr/selectableItemBackground">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_lock" app:tint="@color/colorTextSecondary" android:contentDescription="Privacy"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Privacy Policy" android:layout_marginStart="16dp" android:textSize="15sp" android:textColor="@color/colorTextPrimary"/>
        </LinearLayout>

        <!-- TERMS -->
        <LinearLayout
            android:id="@+id/menuTerms"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center_vertical"
            android:foreground="?attr/selectableItemBackground">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_terms" app:tint="@color/colorTextSecondary" android:contentDescription="Terms"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Terms &amp; Conditions" android:layout_marginStart="16dp" android:textSize="15sp" android:textColor="@color/colorTextPrimary"/>
        </LinearLayout>

        <!-- RATE -->
        <LinearLayout
            android:id="@+id/menuRate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center_vertical"
            android:foreground="?attr/selectableItemBackground">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_star" app:tint="@color/colorTextSecondary" android:contentDescription="Rate"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rate Us" android:layout_marginStart="16dp" android:textSize="15sp" android:textColor="@color/colorTextPrimary"/>
        </LinearLayout>

        <!-- SHARE -->
        <LinearLayout
            android:id="@+id/menuShare"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center_vertical"
            android:foreground="?attr/selectableItemBackground">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_share" app:tint="@color/colorTextSecondary" android:contentDescription="Share"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Share App" android:layout_marginStart="16dp" android:textSize="15sp" android:textColor="@color/colorTextPrimary"/>
        </LinearLayout>

        <!-- Spacer -->
        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>

        <!-- Divider -->
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/colorDivider"/>

        <!-- LOGOUT -->
        <LinearLayout
            android:id="@+id/menuLogout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center_vertical"
            android:foreground="?attr/selectableItemBackground">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_logout" app:tint="@color/pinkPrimary" android:contentDescription="Logout"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Logout" android:textColor="@color/pinkPrimary" android:layout_marginStart="16dp" android:textSize="15sp" android:textStyle="bold"/>
        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
