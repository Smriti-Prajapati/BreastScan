<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upload &amp; Scan Report"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/pinkPrimary"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upload your medical report or scan it to extract values"
            android:textSize="14sp"
            android:textColor="@color/colorTextSecondary"
            android:layout_marginBottom="20dp" />

        <!-- Image preview card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/colorCardBackground"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/ivPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Report preview" />
        </androidx.cardview.widget.CardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpload"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Upload Report Image"
            android:textAllCaps="false"
            android:textColor="@color/colorTextOnPrimary"
            android:layout_marginBottom="12dp"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/pinkPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScan"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Scan Using Camera"
            android:textAllCaps="false"
            android:textColor="@color/colorTextOnPrimary"
            android:layout_marginBottom="12dp"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/pinkAccent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExtract"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Extract Values"
            android:textAllCaps="false"
            android:textColor="@color/colorTextOnPrimary"
            android:layout_marginBottom="28dp"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/pinkDark" />

    </LinearLayout>
</ScrollView>
