<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@color/colorHeaderBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="16dp"
            android:elevation="4dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_back_arrow"
                android:contentDescription="Back"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Medical Document Q&amp;A"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Body -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Upload a medical PDF and ask plain-language questions about its content."
                android:textColor="@color/colorTextSecondary"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="20dp" />

            <!-- Step 1 card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/colorCardBackground"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Step 1 — Upload PDF"
                        android:textColor="@color/colorTextBrand"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:id="@+id/tvFileName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No file selected"
                        android:textColor="@color/colorTextHint"
                        android:textSize="13sp"
                        android:background="@drawable/edittext_bg"
                        android:padding="12dp"
                        android:layout_marginBottom="14dp"
                        android:singleLine="true"
                        android:ellipsize="middle" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChoosePdf"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Choose PDF from Device"
                        android:textAllCaps="false"
                        android:textColor="@color/pinkPrimary"
                        android:layout_marginBottom="10dp"
                        app:cornerRadius="14dp"
                        app:backgroundTint="@color/colorSurfaceVariant"
                        app:strokeColor="@color/pinkPrimary"
                        app:strokeWidth="1.5dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUpload"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Upload &amp; Process"
                        android:textAllCaps="false"
                        android:textColor="@color/colorTextOnPrimary"
                        app:cornerRadius="14dp"
                        app:backgroundTint="@color/pinkPrimary"
                        android:enabled="false" />

                    <TextView
                        android:id="@+id/tvUploadStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="13sp"
                        android:textColor="@color/colorSuccess"
                        android:layout_marginTop="10dp"
                        android:visibility="gone" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Step 2 card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/colorCardBackground"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Step 2 — Ask a Question"
                        android:textColor="@color/colorTextBrand"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="14dp" />

                    <EditText
                        android:id="@+id/etQuestion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. What are the main risk factors mentioned?"
                        android:minLines="2"
                        android:maxLines="4"
                        android:inputType="textMultiLine|textCapSentences"
                        android:background="@drawable/edittext_bg"
                        android:padding="14dp"
                        android:textSize="14sp"
                        android:textColor="@color/colorTextPrimary"
                        android:textColorHint="@color/colorTextHint"
                        android:layout_marginBottom="14dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAsk"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="Get Answer"
                        android:textAllCaps="false"
                        android:textColor="@color/colorTextOnPrimary"
                        android:textSize="16sp"
                        app:cornerRadius="16dp"
                        app:backgroundTint="@color/pinkPrimary"
                        android:enabled="false" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Loading -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                android:indeterminateTint="@color/pinkPrimary" />

            <!-- Answer card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardAnswer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/colorCardBackground"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Answer"
                        android:textColor="@color/colorTextBrand"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/colorDivider"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:id="@+id/tvAnswer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="15sp"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="16dp" />

                    <!-- Source box -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/source_bg"
                        android:padding="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📌 Source"
                            android:textColor="@color/colorTextBrand"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tvSource"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="12sp"
                            android:lineSpacingExtra="3dp" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Disclaimer -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚠️ This tool is for educational purposes only and is not a substitute for professional medical advice. Always consult a qualified healthcare provider."
                android:textColor="@color/colorTextHint"
                android:textSize="11sp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="28dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
